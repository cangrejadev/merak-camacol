{#
	Organism-Blocks MRK Theme Merak - Projects 
	=========================
	Description:
	- Block for Projects
	Campos: 
	Titulo: {{ post.title }}
	Enlace : {{ post.link }}
	Fecha: {{ post.date }}
	Imagen destacada: {{ post.thumbnail|adjust(450,250) }}
	Extracto: {{ post.preview.length(20).read_more(false) }}
	Tipo de post: {{post.post_type}}
	ID: {{post.ID}}MRK
#}
<section class="grid-articles">
	{% for project in projects %} 
		{% include "organisms/components/tease-project.twig" with {  'project': project } %}
	{% endfor %}
</section>