{#
	Organism-Blocks MRK Theme Merak - Projects 
	=========================
	Description:
	- Block for Projects
	Campos: 
	Titulo: {{ post.title }}
	Enlace : {{ post.link }}
	Fecha: {{ post.date }}
	Imagen destacada: {{ post.thumbnail|adjust(450,250) }}
	Extracto: {{ post.preview.length(20).read_more(false) }}
	Tipo de post: {{post.post_type}}
	ID: {{post.ID}}
#}
<section class="carousel-default carousel--latest-posts-card owl-carousel owl-theme carousel-servicios" data-columns="4">
	{% set services = fn('json_decode', post.services) %}
	{% for item in services %}
		{% include "organisms/components/card-service.twig" with {  'service': item } %}
	{% endfor %}
</section>
