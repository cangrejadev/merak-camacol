{#
		Organism-Componets Theme Merak - Stepper 
		=========================
		Description:
		- Stepper Component for Post Grid
#}
<div class="stepper__container">
  <div class="step active">
    <div class="step__icon">
      <i class="fa-solid fa-pen-to-square"></i>
    </div>
    <p class="step__label">Solicitud<br>proyecto</p>
  </div>
  <div class="step">
    <div class="step__icon">
      <i class="fa-solid fa-gears"></i>
    </div>
    <p class="step__label">Administración<br>proyecto</p>
  </div>
  <div class="step">
    <div class="step__icon">
      <i class="fa-solid fa-money-bills"></i>
    </div>
    <p class="step__label">Aprobación<br>proyecto</p>
  </div>
  <div class="step">
    <div class="step__icon">
      <i class="fas fa-flag-checkered"></i>
    </div>
    <p class="step__label">Finalización<br>proyecto</p>
  </div>
</div>
